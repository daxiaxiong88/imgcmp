{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "图片对比排列器",
  "version": "1.1.0",
  "identifier": "com.daxiaxiong88.imgcmp",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "图片对比排列器",
        "width": 1480,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
